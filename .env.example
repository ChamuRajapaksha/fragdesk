# Copy this file to `.env` and fill in your Supabase project credentials.
#
# Only the PUBLIC anon key belongs in VITE_* variables -- anything prefixed
# with VITE_ is compiled into the frontend bundle and readable by anyone.
# Never put the service-role key or any other secret here.
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key
